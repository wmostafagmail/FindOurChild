# Revised data-free prototype. Named asset acquisition remains hard-disabled.
FROM --platform=linux/amd64 python:3.13.13-bookworm@sha256:2383bb1108fe80f7191b1f3ddbbd2ce1a13a1e99e7400a42fa28b27defa34841 AS build
ENV PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 SOURCE_DATE_EPOCH=1747267200
WORKDIR /build
COPY wheels /wheels
COPY requirements-build.txt ./
RUN --network=none python -m pip install --no-index --no-deps --require-hashes --find-links=/wheels -r requirements-build.txt
COPY source /build/source
COPY native /build/native
COPY source-receipt.json dependency-lock.json build_manifest.py package_probe.py /build/
COPY audit_source.py source-projection.json /build/
RUN --network=none python audit_source.py /build/source /build/source-projection.json > /build/source-policy-audit.json
RUN --network=none cmake -S /build/native -B /build/native-build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /build/native-build --parallel 2 \
    && python /build/package_probe.py
RUN --network=none mkdir /runtime-libs /runtime-notices \
    && cp -L /usr/lib/x86_64-linux-gnu/libstdc++.so.6 /runtime-libs/libstdc++.so.6 \
    && cp -L /usr/share/doc/libstdc++6/copyright /runtime-notices/libstdc++6-copyright.txt \
    && python /build/build_manifest.py

FROM --platform=linux/amd64 python:3.13.13-slim-bookworm@sha256:355bfa66770995d7e9a0da4b3473b44d0cb451f6b56f5615ad9c39e3c4eca03f
ENV PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 DLIB_NUM_THREADS=1
WORKDIR /opt/qualification
COPY --from=build /build/dist/*.whl /wheels/
COPY --from=build /wheels/numpy-*.whl /wheels/
COPY --from=build /build/evidence /opt/qualification/evidence
COPY --from=build /runtime-libs/ /usr/local/lib/
COPY --from=build /runtime-notices/ /usr/share/doc/foc-runtime/
RUN --network=none python -m pip install --no-index --no-deps /wheels/*.whl && rm -r /wheels && ldconfig
COPY preflight.py interface_checks.py native_fixtures.py native-test-inventory.json ./
COPY --from=build /build/native-build/native_contract_tests /opt/qualification/native_contract_tests
RUN --network=none python native_fixtures.py && rm native_fixtures.py
COPY --from=build /build/dist /opt/qualification/build-outputs/wheels
COPY --from=build /build/native-build/native_contract_tests /opt/qualification/build-outputs/native_contract_tests
COPY --from=build /build/native-build/_foc_dlib_native.cpython-313-x86_64-linux-gnu.so /opt/qualification/build-outputs/_foc_dlib_native.cpython-313-x86_64-linux-gnu.so
USER 10001:10001
ENTRYPOINT ["python", "/opt/qualification/preflight.py"]
