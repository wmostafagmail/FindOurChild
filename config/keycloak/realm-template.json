{
  "realm": "foc-synthetic",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "ssoSessionIdleTimeout": 600,
  "ssoSessionMaxLifespan": 1800,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "en"
  ],
  "defaultLocale": "en",
  "browserFlow": "staff-mfa",
  "authenticationFlows": [
    {
      "alias": "staff-mfa",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "pwd-reference",
          "authenticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorConfig": "otp-reference",
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "pwd-reference",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "1800"
      }
    },
    {
      "alias": "otp-reference",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "1800"
      }
    }
  ],
  "clients": [
    {
      "clientId": "foc-bff",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://127.0.0.1:3443/identity/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "foc-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "bff-introspection-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "foc-bff",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
